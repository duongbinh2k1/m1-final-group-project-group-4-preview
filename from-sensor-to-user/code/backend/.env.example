MQTT_BROKER=ace2ba13.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USERNAME=mushroom-backend
MQTT_PASSWORD=your-mqtt-password
MQTT_CA_CERT=emqxsl-ca.crt
MQTT_TOPIC_PREFIX=mushroom-farm

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth (JWT) — users/passwords stored in Supabase, see docs/supabase_setup.sql
AUTH_SECRET_KEY=generate-with: openssl rand -hex 32
AUTH_TOKEN_EXPIRE_HOURS=24

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Dùng service_role key (không phải anon key) để bypass RLS
SUPABASE_KEY=your-service-role-secret-key

# Telegram Bot notifications
# 1. Tạo bot: nhắn @BotFather → /newbot → copy token
# 2. Lấy chat_id: nhắn bot 1 tin, mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
TELEGRAM_CHAT_ID=987654321
